{
  "name": "gitsult4n-beacon",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "whose-side", "database_id": "fb559f94-d2bb-4926-a9d9-f9945a8ed2fa", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "FORM_LIMIT", "namespace_id": "4401", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [
    { "pattern": "gitsult4n.com", "custom_domain": true },
    { "pattern": "www.gitsult4n.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
