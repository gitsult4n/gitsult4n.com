{
  "name": "gitsult4n-beacon",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "4401", "simple": { "limit": 12, "period": 60 } }
  ],
  "routes": [
    { "pattern": "gitsult4n.com", "custom_domain": true },
    { "pattern": "www.gitsult4n.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
